<?xml version="1.0"?>
<robot name="$(arg mav_name)" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Include base MAV model (if needed) -->
  <xacro:include filename="$(find rotors_description)/urdf/mav_with_vi_sensor.gazebo" />

  <!-- Add a downward-facing Gazebo camera -->
  <link name="downward_cam_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>  <!-- Small visual marker (optional) -->
      </geometry>
    </visual>
  </link>

  <joint name="downward_cam_joint" type="fixed">
    <parent link="${namespace}/base_link"/>
    <child link="downward_cam_link"/>
    <origin xyz="0.0 0.0 -0.05" rpy="0.0 -1.5708 0.0"/>  <!-- Downward-facing (90° pitch) -->
  </joint>

  <!-- Gazebo camera sensor -->
  <gazebo reference="downward_cam_link">
    <sensor name="downward_cam" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60° FOV -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <plugin name="downward_cam_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>downward_cam</camera_name>
        <frame_name>downward_cam_link</frame_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>