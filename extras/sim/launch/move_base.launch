<group ns="firefly">
  <launch>
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
      <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
      <rosparam file="$(find rotors_gazebo)/config/costmap_common_params.yaml" command="load"/>
      <rosparam file="$(find rotors_gazebo)/config/local_costmap_params.yaml" command="load"/>
      <rosparam file="$(find rotors_gazebo)/config/global_costmap_params.yaml" command="load"/>
      <rosparam file="$(find rotors_gazebo)/config/dwa_local_planner_params.yaml" command="load"/>
    </node>
  </launch>
</group>