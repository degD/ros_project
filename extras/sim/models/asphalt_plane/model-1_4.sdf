<?xml version="1.0" ?>
<sdf version="1.4">
  <model name="asphalt_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>20 20 .1</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box>
            <size>20 20 .1</size>
          </box>
        </geometry>
		    <material>
		      <ambient>0.6 0.6 0.6 1</ambient>   <!-- Brightens under ambient light -->
		      <diffuse>0.8 0.8 0.8 1</diffuse>   <!-- Main color under direct light -->
		      <specular>0.1 0.1 0.1 1</specular> <!-- Reflectivity/gloss -->
		      <emissive>0 0 0 1</emissive>
		    </material>
      </visual>
    </link>
  </model>
</sdf>
